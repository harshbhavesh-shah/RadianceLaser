rules_version = '2';

// Multi-tenant isolation model:
// - Every user's Firebase Auth token carries custom claims: clinicId + role
//   (set server-side in scripts/createClinic.mjs — never trust claims a
//   client could set themselves).
// - Every data document (appointments, patients, etc.) stores a clinicId
//   field matching the clinic it belongs to.
// - Every rule below checks that the requester's token clinicId matches the
//   document's clinicId, so one clinic's staff can never read or write
//   another clinic's data, even if they guessed a document ID.
//
// Trial/subscription enforcement:
// - Every clinic doc carries subscriptionStatus + trialEndsAt (see
//   types/index.ts Clinic, lib/subscription.ts getClinicAccess). Writes to
//   any tenant-scoped collection additionally require clinicIsActive() —
//   this is the actual hard-lock enforcement once a trial ends: a clinic
//   past its trial with no active subscription can still read all its own
//   data (nothing here changes read rules) but can no longer create,
//   update, or delete anything, from any client, regardless of what the
//   Next.js server code does or doesn't check. lib/subscription.ts mirrors
//   this logic for UI decisions (banners, disabling buttons) but is not
//   itself a security boundary — this file is.
//
// Deploy with: firebase deploy --only firestore:rules

function isSignedIn() {
  return request.auth != null;
}

function clinicId() {
  return request.auth.token.clinicId;
}

function belongsToClinic(data) {
  return isSignedIn() && data.clinicId == clinicId();
}

function clinicIsActive(cid) {
  // Hardcoded "(default)" rather than $(database): this function is
  // declared at the top level, outside the `match /databases/{database}/...`
  // block below, so the `database` path binding isn't in scope here —
  // referencing it silently resolved to nothing and made get() fail, which
  // made every write rule using this function evaluate to false (a real
  // incident: this blocked ALL writes, including for "active" clinics,
  // until caught and fixed). This project only has the one "(default)"
  // Firestore database, so hardcoding it is safe.
  let clinic = get(/databases/(default)/documents/clinics/$(cid)).data;
  // "active" isn't unconditional forever — it only counts through
  // subscriptionRenewsAt (the end of the period the last payment covered).
  // Must mirror lib/subscription.ts getClinicAccess exactly, or the UI and
  // the actual enforcement here disagree about whether a lapsed-but-still-
  // marked-"active" clinic can write.
  return (clinic.subscriptionStatus == 'active'
            && (!('subscriptionRenewsAt' in clinic) || request.time.toMillis() < clinic.subscriptionRenewsAt))
    || (clinic.subscriptionStatus == 'trialing' && request.time.toMillis() < clinic.trialEndsAt);
}

// Shorthand for the common case: the requester's own clinic (from their
// auth token) must be active/trialing to write.
function callerClinicIsActive() {
  return clinicIsActive(clinicId());
}

// Lets an unauthenticated visitor create exactly one narrow shape of
// appointment: a Laser Hair Removal booking made through the marketing
// site's public appointment form (see advancedskinclinic-new/src/
// appointment.njk, which writes here directly since RadianceLaser has no
// slot/queue system to route this through server-side). Tightly scoped so
// this can't be abused to write arbitrary appointment data: fixed
// sessionType/status, no patientId (public bookers aren't linked to an
// existing Patient record), and only the expected fields — anything else
// on the doc is rejected. Still gated on the target clinic being
// active/trialing, same as every other write.
function isValidPublicLhrBooking(data) {
  return data.clinicId is string
    && clinicIsActive(data.clinicId)
    && data.patientId == ""
    && data.sessionType == "lhr"
    && data.status == "booked"
    && data.patientName is string && data.patientName.size() > 0
    && data.patientPhone is string && data.patientPhone.size() > 0
    && data.date is string
    && data.time is string
    && data.durationMinutes is number
    && data.keys().hasOnly(
         ['clinicId', 'patientId', 'patientName', 'patientPhone', 'sessionType',
          'date', 'time', 'durationMinutes', 'status', 'notes', 'createdAt']);
}

service cloud.firestore {
  match /databases/{database}/documents {

    // The clinic's own profile doc — readable by its own staff, not writable
    // by clients at all (only the Admin SDK / server, e.g. a future Razorpay
    // webhook, should update subscriptionStatus/trialEndsAt on this doc).
    match /clinics/{clinicId} {
      allow read: if isSignedIn() && request.auth.token.clinicId == clinicId;
      allow write: if false;
    }

    // Every tenant-scoped collection follows the same pattern. Add more
    // collections here as the product grows — each one just needs a
    // clinicId field on its documents and this same rule shape.
    //
    // NOTE on delete: request.resource doesn't exist for a delete operation
    // (there's no new document being written), so a delete rule can only
    // check resource.data (the document as it existed before removal) — not
    // request.resource.data. Checking request.resource.data on delete always
    // evaluates to false, silently blocking every delete. Keep update and
    // delete as separate allow statements, not combined, to avoid this.
    match /appointments/{appointmentId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if (belongsToClinic(request.resource.data) && callerClinicIsActive())
        || isValidPublicLhrBooking(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data) // can't change clinicId on update
        && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    match /patients/{patientId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data)
        && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    match /visits/{visitId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data)
        && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    match /packages/{packageId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data)
        && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    match /counters/{counterId} {
      // resource == null when the counter doc doesn't exist yet (e.g. the
      // very first receipt a clinic ever issues) — without this check,
      // resource.data on a nonexistent doc throws and the read is denied,
      // which aborts the allocateReceiptNumber() transaction in
      // lib/receiptNumber.ts before it ever gets to create the doc. Safe to
      // allow: a nonexistent doc has no data to protect, and counter IDs are
      // derived from the caller's own clinicId anyway.
      allow read: if resource == null || belongsToClinic(resource.data);
      allow write: if belongsToClinic(request.resource.data) && callerClinicIsActive();
    }

    // Firestore mirror of Firebase Auth users (see app/dashboard/settings/actions.ts).
    // Deliberately read-only for clients — staff are added/edited/removed
    // only through server actions using the Admin SDK, which bypasses these
    // rules entirely. A client should never be able to grant itself a role
    // by writing directly to this collection.
    match /staff/{staffId} {
      allow read: if belongsToClinic(resource.data);
      allow write: if false;
    }

    // Razorpay payment records — see types/index.ts Payment and
    // app/dashboard/billing/actions.ts / app/api/webhooks/razorpay/route.ts.
    // Deliberately read-only for clients, same reasoning as staff above: a
    // client should never be able to mark its own payment "paid" (and
    // thereby unlock itself) by writing directly to this collection —
    // only the Admin-SDK-backed verification action and webhook can.
    match /payments/{paymentId} {
      allow read: if belongsToClinic(resource.data);
      allow write: if false;
    }

    // Pending email-OTP 2FA codes (see lib/twoFactor.ts) — keyed by uid, not
    // clinic-scoped like everything else here. Entirely server-only: only
    // the Admin SDK (via app/login/actions.ts) ever reads or writes these,
    // so there's no client access at all, not even read — a client that
    // could read its own challenge doc would just be reading the very code
    // it's supposed to prove it received by email.
    match /twoFactorChallenges/{uid} {
      allow read, write: if false;
    }

    match /machines/{machineId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data)
        && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    // Clinic-defined major machine types (e.g. "CO2 Laser"), on top of the
    // built-in Q-Switch/LHR types — see types/index.ts SessionTypeDef and
    // components/settings/MachineTypeFormModal.tsx.
    match /sessionTypeDefs/{sessionTypeDefId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data)
        && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    // Before/after photo metadata — see types/index.ts PatientPhoto. The
    // actual image bytes live in Firebase Storage (see storage.rules);
    // this is just the per-photo record (who took it, which visit, the
    // download URL, the sensitive flag).
    match /patientPhotos/{photoId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data)
        && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    // Clinic-authored consent form templates — see types/index.ts
    // ConsentFormTemplate and components/settings/ConsentTemplateFormModal.tsx.
    match /consentFormTemplates/{templateId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data)
        && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    // Signed consent forms — see types/index.ts ConsentForm. Deliberately no
    // update rule: once signed, a consent record shouldn't be editable, only
    // created or removed (e.g. if logged in error). The signature image
    // itself lives in Firebase Storage — see storage.rules.
    match /consentForms/{consentFormId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    // Patient-wise receipts, generated from the Documents section — see
    // types/index.ts Receipt. No update rule: once issued a receipt is
    // immutable, only created or removed (e.g. if issued in error) — same
    // reasoning as consentForms above. receiptNumber is allocated from the
    // counters collection below before this document is written.
    match /receipts/{receiptId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data) && callerClinicIsActive();
      allow delete: if belongsToClinic(resource.data) && callerClinicIsActive();
    }

    // WhatsApp messaging — see types/index.ts and lib/bhashsms/. The
    // connection doc holds the clinic's BhashSMS credentials
    // (WhatsAppConnection.bhashPass), so it's entirely server-only, same
    // reasoning as twoFactorChallenges above: a client has no legitimate
    // reason to ever read this, let alone write it.
    match /whatsappConnections/{clinicId} {
      allow read, write: if false;
    }

    // Templates are readable client-side (the Communication settings
    // editor lists them), but every write goes through server actions
    // using the Admin SDK, never a direct client write.
    match /messageTemplates/{templateId} {
      allow read: if belongsToClinic(resource.data);
      allow write: if false;
    }

    // Conversations and messages are both read-only client-side (the inbox
    // UI) — writes only ever come from a server action (sending) or an
    // inbound webhook, both Admin SDK.
    match /whatsappConversations/{conversationId} {
      allow read: if belongsToClinic(resource.data);
      allow write: if false;
    }

    match /whatsappMessages/{messageId} {
      allow read: if belongsToClinic(resource.data);
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
