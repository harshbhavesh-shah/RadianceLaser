<file path="firestore.rules">
rules_version = '2';

// Multi-tenant isolation model:
// - Every user's Firebase Auth token carries custom claims: clinicId + role
//   (set server-side in scripts/createClinic.mjs — never trust claims a
//   client could set themselves).
// - Every data document (appointments, patients, etc.) stores a clinicId
//   field matching the clinic it belongs to.
// - Every rule below checks that the requester's token clinicId matches the
//   document's clinicId, so one clinic's staff can never read or write
//   another clinic's data, even if they guessed a document ID.
//
// Deploy with: firebase deploy --only firestore:rules

function isSignedIn() {
  return request.auth != null;
}

function clinicId() {
  return request.auth.token.clinicId;
}

function belongsToClinic(data) {
  return isSignedIn() && data.clinicId == clinicId();
}

service cloud.firestore {
  match /databases/{database}/documents {

    // The clinic's own profile doc — readable by its own staff, not writable
    // by clients at all (only the Admin SDK / server should update this).
    match /clinics/{clinicId} {
      allow read: if isSignedIn() && request.auth.token.clinicId == clinicId;
      allow write: if false;
    }

    // Every tenant-scoped collection follows the same pattern. Add more
    // collections here as the product grows — each one just needs a
    // clinicId field on its documents and this same rule shape.
    //
    // NOTE on delete: request.resource doesn't exist for a delete operation
    // (there's no new document being written), so a delete rule can only
    // check resource.data (the document as it existed before removal) — not
    // request.resource.data. Checking request.resource.data on delete always
    // evaluates to false, silently blocking every delete. Keep update and
    // delete as separate allow statements, not combined, to avoid this.
    match /appointments/{appointmentId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data); // can't change clinicId on update
      allow delete: if belongsToClinic(resource.data);
    }

    match /patients/{patientId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    match /visits/{visitId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    match /packages/{packageId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    match /counters/{counterId} {
      // resource == null when the counter doc doesn't exist yet (e.g. the
      // very first receipt a clinic ever issues) — without this check,
      // resource.data on a nonexistent doc throws and the read is denied,
      // which aborts the allocateReceiptNumber() transaction in
      // lib/receiptNumber.ts before it ever gets to create the doc. Safe to
      // allow: a nonexistent doc has no data to protect, and counter IDs are
      // derived from the caller's own clinicId anyway.
      allow read: if resource == null || belongsToClinic(resource.data);
      allow write: if belongsToClinic(request.resource.data);
    }

    // Firestore mirror of Firebase Auth users (see app/dashboard/settings/actions.ts).
    // Deliberately read-only for clients — staff are added/edited/removed
    // only through server actions using the Admin SDK, which bypasses these
    // rules entirely. A client should never be able to grant itself a role
    // by writing directly to this collection.
    match /staff/{staffId} {
      allow read: if belongsToClinic(resource.data);
      allow write: if false;
    }

    match /machines/{machineId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    // Clinic-defined major machine types (e.g. "CO2 Laser"), on top of the
    // built-in Q-Switch/LHR types — see types/index.ts SessionTypeDef and
    // components/settings/MachineTypeFormModal.tsx.
    match /sessionTypeDefs/{sessionTypeDefId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    // Before/after photo metadata — see types/index.ts PatientPhoto. The
    // actual image bytes live in Firebase Storage (see storage.rules);
    // this is just the per-photo record (who took it, which visit, the
    // download URL, the sensitive flag).
    match /patientPhotos/{photoId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    // Clinic-authored consent form templates — see types/index.ts
    // ConsentFormTemplate and components/settings/ConsentTemplateFormModal.tsx.
    match /consentFormTemplates/{templateId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow update: if belongsToClinic(resource.data)
        && belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    // Signed consent forms — see types/index.ts ConsentForm. Deliberately no
    // update rule: once signed, a consent record shouldn't be editable, only
    // created or removed (e.g. if logged in error). The signature image
    // itself lives in Firebase Storage — see storage.rules.
    match /consentForms/{consentFormId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    // Patient-wise receipts, generated from the Documents section — see
    // types/index.ts Receipt. No update rule: once issued a receipt is
    // immutable, only created or removed (e.g. if issued in error) — same
    // reasoning as consentForms above. receiptNumber is allocated from the
    // counters collection below before this document is written.
    match /receipts/{receiptId} {
      allow read: if belongsToClinic(resource.data);
      allow create: if belongsToClinic(request.resource.data);
      allow delete: if belongsToClinic(resource.data);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
</file>

<file path="app/dashboard/settings/patientImportActions.ts">
"use server";

import { getSession } from "@/lib/session";
import { getPatients, createPatient, updatePatient } from "@/lib/firestore/patients";
import { normalizePhone } from "@/lib/phone";
import type { ImportPatientRow } from "@/lib/patientImport";

export type DuplicateAction = "skip" | "replace";

export interface ImportPatientsResult {
  imported: number;
  updated: number; // duplicates overwritten, only when duplicateAction is "replace"
  skippedDuplicates: number; // duplicates left untouched, only when duplicateAction is "skip"
  failed: number;
  errorSamples: string[]; // a few raw error messages, for troubleshooting
}

// A sane ceiling so one bad upload can't try to write an unbounded number of
// documents; well above what a clinic migrating their patient list would
// realistically have in one file.
const MAX_ROWS_PER_IMPORT = 2000;
const BATCH_SIZE = 25; // concurrent writes per batch, to avoid hammering Firestore

/**
 * Bulk-creates (or updates) patients from rows already parsed and
 * column-mapped on the client (see components/settings/PatientImportModal.tsx
 * and lib/patientImport.ts). A row is a "duplicate" if its phone number — or
 * its Patient ID, if mapped — matches an existing patient (or another row
 * earlier in the same file). duplicateAction controls what happens to those:
 * "skip" (the default, and the only behavior before this option existed)
 * leaves the existing patient untouched; "replace" overwrites their record
 * with the imported row's values — handy when re-importing a corrected
 * export from a clinic's old system. Only the clinic owner can run this,
 * same as the rest of Settings' data-changing actions.
 */
export async function importPatientsAction(
  rows: ImportPatientRow[],
  duplicateAction: DuplicateAction = "skip"
): Promise<ImportPatientsResult> {
  const session = await getSession();
  if (!session) {
    return {
      imported: 0,
      updated: 0,
      skippedDuplicates: 0,
      failed: rows.length,
      errorSamples: ["Not signed in."],
    };
  }
  if (session.role !== "owner") {
    return {
      imported: 0,
      updated: 0,
      skippedDuplicates: 0,
      failed: rows.length,
      errorSamples: ["Only the clinic owner can import patients."],
    };
  }

  const limited = rows.slice(0, MAX_ROWS_PER_IMPORT);
  const existingPatients = await getPatients(session.clinicId);
  // Maps a normalized phone/code to the patient it belongs to — used both to
  // detect duplicates and, for "replace", to know which document to
  // overwrite. Updated as rows are processed, so two duplicate rows in the
  // same file are handled consistently against each other, not just against
  // what was already in Firestore before this import started.
  // Explicit [string, string] return types below are required, not
  // stylistic — without them, TS infers `.map()`'s array-literal return as
  // the widened `string[]` rather than a tuple, and chaining `.filter()`
  // afterward loses whatever contextual tuple typing `new Map()` might
  // otherwise have inferred. That mismatch (string[] vs. the tuple shape
  // Map's constructor expects) is exactly what broke the Vercel build.
  const byPhone = new Map<string, string>(
    existingPatients
      .filter((p) => normalizePhone(p.phone))
      .map((p): [string, string] => [normalizePhone(p.phone), p.id])
  );
  const byCode = new Map<string, string>(
    existingPatients
      .map((p): [string, string] => [p.patientCode.trim().toUpperCase(), p.id])
      .filter(([code]) => code)
  );

  let imported = 0;
  let updated = 0;
  let skippedDuplicates = 0;
  let failed = 0;
  const errorSamples: string[] = [];

  for (let i = 0; i < limited.length; i += BATCH_SIZE) {
    const batch = limited.slice(i, i + BATCH_SIZE);
    const results = await Promise.allSettled(
      batch.map(async (row) => {
        const normalizedPhone = normalizePhone(row.phone);
        const normalizedCode = row.patientCode?.trim().toUpperCase();
        const existingId =
          (normalizedPhone && byPhone.get(normalizedPhone)) ||
          (normalizedCode && byCode.get(normalizedCode)) ||
          undefined;

        if (existingId) {
          if (duplicateAction === "skip") {
            return "duplicate" as const;
          }
          await updatePatient(session.clinicId, existingId, row);
          return "updated" as const;
        }

        // Marked as seen synchronously, before the create below actually
        // awaits — safe because every row's map callback runs up to its
        // first `await` in order, so two rows with the same phone number
        // (or patient ID) within this batch can't both slip past the check.
        const newId = await createPatient({ clinicId: session.clinicId, ...row });
        if (normalizedPhone) byPhone.set(normalizedPhone, newId);
        if (normalizedCode) byCode.set(normalizedCode, newId);
        return "imported" as const;
      })
    );

    for (const result of results) {
      if (result.status === "fulfilled") {
        if (result.value === "imported") imported++;
        else if (result.value === "updated") updated++;
        else skippedDuplicates++;
      } else {
        failed++;
        if (errorSamples.length < 5) {
          errorSamples.push(result.reason instanceof Error ? result.reason.message : "Unknown error");
        }
      }
    }
  }

  return { imported, updated, skippedDuplicates, failed, errorSamples };
}
</file>

<file path="app/dashboard/layout.tsx">
import { redirect } from "next/navigation";
import { getSession } from "@/lib/session";
import { adminDb } from "@/lib/firebase/admin";
import { getClinicSessionTypeDefs } from "@/lib/firestore/sessionTypeDefs";
import { buildSessionTypeConfig } from "@/lib/sessionTypes";
import { SessionTypeConfigProvider } from "@/lib/sessionTypeConfigContext";
import Sidebar from "@/components/Sidebar";
import { SidebarProvider } from "@/components/SidebarContext";

export default async function DashboardLayout({ children }: { children: React.ReactNode }) {
  // This is the REAL auth check — middleware.ts only checked that a cookie
  // exists; this verifies it's genuinely valid and pulls the clinicId/role
  // claims every page under /dashboard needs.
  const session = await getSession();
  if (!session) {
    redirect("/login");
  }

  const [clinicSnap, sessionTypeDefs] = await Promise.all([
    adminDb().collection("clinics").doc(session.clinicId).get(),
    getClinicSessionTypeDefs(session.clinicId),
  ]);
  const clinicName = clinicSnap.exists ? (clinicSnap.data()?.name as string) : "Your Clinic";
  const sessionTypeConfig = buildSessionTypeConfig(sessionTypeDefs);

  return (
    <SidebarProvider>
      <SessionTypeConfigProvider initialConfig={sessionTypeConfig}>
        <div className="flex h-screen flex-col overflow-hidden bg-canvas md:flex-row">
          <Sidebar clinicName={clinicName} session={session} />
          <main className="flex-1 overflow-y-auto overflow-x-hidden p-4 md:p-8">{children}</main>
        </div>
      </SessionTypeConfigProvider>
    </SidebarProvider>
  );
}
