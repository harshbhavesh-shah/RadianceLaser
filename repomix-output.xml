  clinicName,
  clinicAddress,
  patients,
  visits,
  packages,
  templates,
  initialForms,
  initialReceipts,
  currentUid,
  currentName,
  canManageTemplates,
  initialTab,
  autoOpenReceiptPatientId,
  autoAddReceiptVisitId,
}: {
  clinicId: string;
  clinicName: string;
