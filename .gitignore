# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env files — never commit real secrets
.env
.env.local
.env*.local

# firebase admin service account (if you drop the JSON file locally instead of using env vars)
serviceAccountKey.json

# misc
.DS_Store
*.pem
npm-debug.log*

# global-bundle.pem IS committed, despite the *.pem rule above — it's AWS's
# public RDS CA bundle (no secret in it), and lib/db/client.ts reads it from
# disk at runtime (readFileSync(process.cwd())). Without it committed, every
# Postgres connection on a fresh deploy (Vercel clones from git, this file
# was never pushed) throws ENOENT the moment a request touches Prisma.
!global-bundle.pem

# Playwright — e2e/.auth holds a real (throwaway-clinic) session cookie
# from the last local run; playwright-report/test-results are regenerated
# every run.
/e2e/.auth
/playwright-report
/test-results
