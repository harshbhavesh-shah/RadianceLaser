# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Auth (self-rolled session cookies + 2FA/password-reset tickets) ---
# A long random secret used to HMAC-sign session cookies and short-lived
# tickets — see lib/auth/signedToken.ts. Needed in both the Node runtime
# (server actions) and the Edge runtime (middleware.ts), which is why this
# isn't reused from an existing Firebase/DB secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every existing session and pending 2FA/reset
# ticket — treat it like a password, not a config toggle.
AUTH_SESSION_SECRET=

# --- Firebase ADMIN config (server-side only, keep secret) ---
# No Firebase CLIENT config exists anymore — sign-in (email/password and
# Google) is fully self-rolled (see the Auth section above and lib/auth/*),
# so there's no client-side Firebase SDK left in the app. This admin config
# is still needed for Firestore (plenty of data still lives there, see
# lib/firestore/*) and FCM push notifications (lib/push/send.ts) — both
# unrelated to authentication.
# From Firebase Console → Project Settings → Service Accounts → Generate new private key.
# That downloads a JSON file. Copy the three fields below out of it.
# IMPORTANT: paste the private_key value exactly, keeping it wrapped in quotes —
# it contains literal \n characters that need to stay intact.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# Secret used to authorize the one-off scripts/createClinic.mjs bootstrap script.
# Make up any long random string. Only needed locally, never deployed.
SETUP_SECRET=

# --- Postgres (AWS RDS) ---
# Patient/Visit/Package/Appointment/Receipt/StaffMember/Machine/
# SessionTypeDef/ConsentFormTemplate/ConsentForm/PatientPhoto/
# MessageTemplate/Clinic live here — see prisma/schema.prisma and
# lib/db/*.ts. Standard postgres:// connection string; TLS is configured
# separately in lib/db/client.ts (reads global-bundle.pem, AWS's public RDS
# CA bundle, committed to the repo root — not something you need to fetch
# yourself).
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=verify-full"

# --- Razorpay (billing) ---
# From the Razorpay Dashboard → Settings → API Keys. Use test-mode keys for
# local dev — they work immediately, before KYC/business verification
# finishes. RAZORPAY_KEY_ID is also read client-side by
# components/settings/BillingSection.tsx (passed down from a server action,
# never exposed via NEXT_PUBLIC_ — Razorpay Checkout only ever needs the key
# ID in the browser, never the secret).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From the Razorpay Dashboard → Settings → Webhooks, after creating a webhook
# pointing at https://yourdomain/api/webhooks/razorpay with the
# "payment.captured" event enabled. This is a DIFFERENT secret from
# RAZORPAY_KEY_SECRET above — it's generated specifically for that webhook.
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (transactional email — currently just 2FA sign-in codes) ---
# From resend.com → API Keys. Works immediately with no domain setup, but
# the default onboarding@resend.dev sender can then only deliver to the
# email address that owns the Resend account — fine for testing 2FA
# yourself, not for real staff accounts. For that, verify your own domain
# in the Resend dashboard and set RESEND_FROM_EMAIL to an address on it,
# e.g. "RadianceLaser <noreply@yourdomain.com>".
RESEND_KEY_ID=
RESEND_FROM_EMAIL=

# --- WhatsApp messaging (BhashSMS) ---
# No env vars needed — each clinic's BhashSMS username/password/sender id
# is entered directly in Communication settings and stored per-clinic in
# Firestore (see lib/bhashsms/client.ts, WhatsAppConnection in types/index.ts).

# --- Scheduled messages (appointment reminders + post-visit feedback) ---
# See app/api/cron/send-scheduled-messages/route.ts, polled by a cron-job.org
# job (not Vercel Cron — Vercel's Hobby plan only runs cron once/day, too
# coarse for this). CRON_SECRET is any long random string; set the exact
# same value on both sides — here, and as a custom request header on the
# cron-job.org job — so the route can tell a real poll from a stranger
# hitting the URL. See README/setup notes for the cron-job.org job config.
CRON_SECRET=
# The clinic-facing domain, no trailing slash — used to build the
# public feedback link (https://<this>/feedback/<token>) sent to patients.
# Must be the real deployed URL, since patients open it from WhatsApp on
# their own phone, not from whatever's serving this request.
NEXT_PUBLIC_APP_URL=https://radiancelaser.in

# The bare root domain (no protocol, no subdomain) that the main app
# itself lives on — middleware.ts uses this to recognize every OTHER
# hostname as a clinic's public-booking subdomain
# (https://{slug}.radiancelaser.in, see lib/clinicSlug.ts) and rewrite it
# to /book/{slug}. Optional — defaults to "radiancelaser.in" (production)
# if unset. For local subdomain testing, set this to "localhost" and
# visit http://{slug}.localhost:3000 — most browsers/OSes resolve
# *.localhost to loopback without any hosts-file editing.
NEXT_PUBLIC_ROOT_DOMAIN=radiancelaser.in

# --- Sentry (error monitoring) ---
# From sentry.io: create a Next.js project, then Settings → Client Keys (DSN).
# SENTRY_AUTH_TOKEN/SENTRY_ORG are optional — only needed for source-map
# uploads so stack traces show real file/line numbers (Settings → Auth
# Tokens). Without them the build just skips that upload step. See
# next.config.js, instrumentation.ts, sentry.*.config.ts.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_PROJECT=
SENTRY_ORG=
SENTRY_AUTH_TOKEN=

# --- Cloudflare Turnstile (bot protection on /signup) ---
# From the Cloudflare dashboard: Turnstile → Add a site. Widget mode
# "Managed" is a good default. NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to
# expose to the browser (that's what the widget itself needs); keep
# TURNSTILE_SECRET_KEY server-side only. See lib/turnstile.ts — until both
# are set, signup runs on IP rate-limiting alone (lib/db/signupAttempts.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 (patient photos + consent-form signatures) ---
# From the Cloudflare dashboard: R2 Object Storage → create a bucket, then
# R2 → Manage API tokens → create a token scoped to that bucket with
# Object Read & Write. See lib/r2.ts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- SMS (SMS Gateway app + Google Apps Script) ---
# Not set up yet — see lib/smsgate/client.ts. Once the Apps Script relay is
# deployed, set this to its web app URL.
SMS_GATE_WEBHOOK_URL=

# --- Google Sign-In ---
# No separate env vars needed — reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET
# below (the web flow's authorization-code exchange needs the secret; see
# lib/auth/googleSignIn.ts). Not Firebase Auth anymore — see lib/authFlow.ts.
#
# Web: the OAuth client's "Authorized JavaScript origins" must include
# wherever /login and /signup are served from (e.g. http://localhost:3000
# for local dev, your production origin for real use) — Google Identity
# Services' popup flow checks this, same as the old Firebase popup did.
#
# Native (Android): also needs a SEPARATE "Android" type OAuth client in
# the same Google Cloud project, registered with the app's package name
# (in.radiancelaser.app, see capacitor.config.ts) and its signing key's
# SHA-1 fingerprint (debug AND release/Play App Signing — see
# @capgo/capacitor-social-login's README for the exact troubleshooting
# steps). That Android client's id is never referenced in code —
# capacitor.config.ts's `webClientId` stays the Web client id above, which
# is what the server actually verifies ID tokens against.

# --- Gmail (admin@radiancelaser.in inbox, app/admin/email) ---
# A Google Cloud OAuth client (Web application type), Gmail API enabled,
# with these two redirect URIs registered:
#   http://localhost:3011/api/oauth/google/callback
#   https://<your-deployed-host>/api/oauth/google/callback
# See Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
